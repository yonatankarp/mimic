# Generated minis: images, meshes and STLs, tens of MB each.
runs/

# The 3D engine and its 8.1 GB of model files, in a Mimic folder made by the old installer
# (the app downloads both, at pinned versions, into ~/Library/Application Support/Mimic otherwise).
engine/

# The queue of `MIMIC_HOME=..` (Mimic Dev and an installed Mimic keep theirs in
# ~/Library/Application Support/Mimic/queues).
/queue/

# The DMG that tools/package_dmg.sh builds, and the release notes the release workflow writes.
dist/
/notes.md

# Agent worktrees, each with its own multi-GB .build folder.
.claude/worktrees/

__pycache__/
*.log
.DS_Store

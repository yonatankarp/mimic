    },
    "Mimic deletes it from your Keychain. To use it later, you'll need to paste it in again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimic deletes it from your Keychain. To use it later, you'll need to paste it in again."
          }
        }
      }
    },
    "Mimic forgets how long your minis took, and uses its own figures until you've made a few more. Your minis are kept." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimic forgets how long your minis took, and uses its own figures until you've made a few more. Your minis are kept."
          }
        }
      }
    },
    "Mimic forgets its settings and saved keys, then opens again as it did the first time. Your minis are kept." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimic forgets its settings and saved keys, then opens again as it did the first time. Your minis are kept."
          }
        }
      }
    },
    "Mimic forgets its settings, tips and any saved AI keys, and shows the tour again. Your minis are kept.\n\nReset All also removes the 3D engine: first-launch setup shows again and downloads it again (%@ GB, depending on the 3D model)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimic forgets its settings, tips and any saved AI keys, and shows the tour again. Your minis are kept.\n\nReset All also removes the 3D engine: first-launch setup shows again and downloads it again (%@ GB, depending on the 3D model)."
          }
        }
      }
    },

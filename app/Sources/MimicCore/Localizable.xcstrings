          }
        }
      }
    },
    "Mimic can't change the picture of %@: its picture isn't made yet. Make another version without a change instead." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mimic can't change the picture of %@: its picture isn't made yet. Make another version without a change instead."
          }
        }
      }
    },
    "Mimic can't make a new 3D shape of %@: its picture isn't made yet. Try Make Another Version instead." : {
      "localizations" : {

			<key>other</key>
			<string>Based on %lld minis made on this Mac</string>
		</dict>
	</dict>
	<key>Each character keeps its own real height. %lld minis have no real height saved, so they get the Character height below.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Each character keeps its own real height. One mini has no real height saved, so it gets the Character height below.</string>
			<key>other</key>
			<string>Each character keeps its own real height. %lld minis have no real height saved, so they get the Character height below.</string>
		</dict>
	</dict>

+// i2l_steps: parse PIXAL3D_STEPS. Anything but a whole number 1..50 keeps the default.
+static int i2l_steps_override(int fallback, const char* raw) {
+    if (!raw || !*raw) return fallback;
+    char* end = nullptr;
+    const long v = std::strtol(raw, &end, 10);
+    if (*end != '\0' || v < 1 || v > 50) return fallback;
+    return (int)v;
+}
